# Slack Bot Token (from OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App Token (from App-Level Tokens, scopes: connections:write)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Groq API Key (from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your-groq-api-key

# Enable mock RTS data (set to true for demo — RTS search:read is user-token only)
MOCK_RTS=true

# Enable mock synthesis (set to true for consistent demo responses)
MOCK_SYNTHESIS=true
