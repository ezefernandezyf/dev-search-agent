{
  "display_information": {
    "name": "Context Bridge"
  },
  "features": {
    "bot_user": {
      "display_name": "Context Bridge",
      "always_online": true
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "search:read"
      ]
    },
    "redirect_urls": ["https://localhost"]
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention"]
    },
    "interactivity": {
      "is_enabled": false
    },
    "socket_mode_enabled": true
  }
}
